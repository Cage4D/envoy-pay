# Copy to agent/.env.mainnet (gitignored) and fill in every value yourself. Never commit agent/.env.mainnet.
# Run with AGENT_ENV=mainnet.
#
# MAINNET USES REAL FUNDS AND TRANSACTIONS ARE IRREVERSIBLE. Review every address and setting yourself
# before running. No value below is pre-filled on purpose.

# The registered agent's private key. Use a dedicated key that holds only what the agent needs.
AGENT_PRIVATE_KEY=

# Network values, from the official chain documentation. Keep in sync with networks.mainnet in src/config.ts.
RPC_URL=
CHAIN_ID=
CHAIN_NAME=
EXPLORER_BASE_URL=
USDC_DECIMALS=6

# The deployed EnvoyVault on this network (see DEPLOYMENTS.md).
VAULT_ADDRESS=

# An address the owner has added as a payee (required).
ALLOWED_PAYEE=

# Optional: an address that is NOT a payee, used for the rejection demo.
# Defaults to the 0x...dEaD burn address, which never receives funds.
NOT_ALLOWED_PAYEE=

# Optional: amount for step a, in USDC (default 0.01). It must stay below the vault's cap.
# The script stops before sending anything if it exceeds the remaining allowance or the vault balance.
PAY_AMOUNT_USDC=0.01
