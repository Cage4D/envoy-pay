# Copy to agent/.env.testnet (gitignored) and fill in. Never commit agent/.env.testnet.
# Run with AGENT_ENV=testnet (the default).

# The registered agent's private key. Use a dedicated test key, never a wallet that holds real funds.
AGENT_PRIVATE_KEY=

# Network (Arc Testnet). Keep in sync with networks.testnet in src/config.ts.
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
CHAIN_NAME=Arc Testnet
EXPLORER_BASE_URL=https://explorer.testnet.arc.io
USDC_DECIMALS=6

# The deployed EnvoyVault on this network.
VAULT_ADDRESS=0x97f975915cd09eed8d6ff2d0eae3aecfad036de0

# An address the owner has added as a payee (required, set it to an address you control).
ALLOWED_PAYEE=

# Optional: an address that is NOT a payee, used for the rejection demo.
# Defaults to the 0x...dEaD burn address, which never receives funds.
NOT_ALLOWED_PAYEE=

# Optional: amount for step a, in USDC (default 0.01).
# The script stops before sending anything if this exceeds the vault's remaining allowance
# for the window or the vault balance. On mainnet it must stay below the vault's cap.
PAY_AMOUNT_USDC=0.01
